# Copy this file to .env for local reference only.
# Real values must be set as Environment Variables in the Vercel project dashboard.

# Stripe (Developers > API keys in the Stripe Dashboard)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Supabase (already in use by the dashboard/orders)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
DASHBOARD_PASSWORD=

# Public site URL (used to build webhook/notification URLs)
SITE_URL=https://your-domain.com
